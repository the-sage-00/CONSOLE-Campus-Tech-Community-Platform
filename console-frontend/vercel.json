{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/console-backend/server.js" 
    },
    {
      "source": "/(.*)",
      "destination": "/console-frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
