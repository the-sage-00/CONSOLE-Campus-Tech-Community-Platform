# Console Frontend - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL (local development)
VITE_API_URL=http://localhost:5000/api

# Admin API URL (usually same as above with /admin)
VITE_ADMIN_API_URL=http://localhost:5000/api/admin

# ============================================
# GOOGLE OAUTH
# ============================================
# Get this from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================
# PRODUCTION URLs (uncomment when deploying)
# ============================================
# VITE_API_URL=https://your-backend-url.onrender.com/api
# VITE_ADMIN_API_URL=https://your-backend-url.onrender.com/api/admin
